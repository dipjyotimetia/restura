{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"],
    "rootDir": "../../..",
    "paths": {
      "@/*": ["../../../src/*"],
      "@shared/*": ["../../../shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../types/**/*.d.ts"]
}
