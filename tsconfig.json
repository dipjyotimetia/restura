{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    },
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["**/*.ts", "**/*.tsx", "vite.config.mts", "electron/types/**/*.ts", "shared/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "worker",
    "electron/main",
    "cli",
    "extension",
    "docs-site"
  ]
}
