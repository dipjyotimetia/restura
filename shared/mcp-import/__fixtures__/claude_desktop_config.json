{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/me/projects"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_supersecret",
        "LOG_LEVEL": "debug",
        "NODE_OPTIONS": "--require ./x.js"
      }
    }
  },
  "globalShortcut": "Ctrl+Space"
}
