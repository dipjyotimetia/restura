{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["**/*.ts", "../e2e/mocks/**/*.ts", "../e2e/utils/**/*.ts"],
  "exclude": ["node_modules"]
}
