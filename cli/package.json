{
  "name": "restura-cli",
  "version": "1.14.0",
  "description": "Restura CLI — run API collections in CI with JUnit/HTML/JSON reporters",
  "license": "MIT",
  "author": "dipjyotimetia",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "restura": "./dist/index.js"
  },
  "sideEffects": false,
  "keywords": [
    "api",
    "rest",
    "graphql",
    "grpc",
    "cli",
    "testing",
    "ci",
    "junit",
    "restura"
  ],
  "homepage": "https://github.com/dipjyotimetia/restura/tree/main/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipjyotimetia/restura.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/dipjyotimetia/restura/issues"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node ../scripts/ensure-rollup-native.mjs && node ../scripts/build-sandbox-libs.mjs",
    "build": "tsup",
    "pretest": "node ../scripts/ensure-sandbox-libs.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "smoke": "node dist/index.js --version && node dist/index.js --help > /dev/null"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1160.0",
    "@aws-sdk/credential-providers": "^3.1160.0",
    "@azure/identity": "^4.14.1",
    "@azure/keyvault-secrets": "^4.12.0",
    "@clack/prompts": "^1.8.1",
    "@faker-js/faker": "^10.6.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "js-yaml": "^5.5.0",
    "log-update": "^8.0.0",
    "quickjs-emscripten": "^0.32.0",
    "undici": "^8.12.3",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "typescript": "^7",
    "vitest": "^5.0.5"
  }
}
