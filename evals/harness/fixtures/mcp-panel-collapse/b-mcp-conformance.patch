+import { FlaskConical } from 'lucide-react';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog';
+
+interface McpConformanceDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  url: string;
+}
+
+/** Era/conformance report: probes the server in the legacy and modern protocol eras (#911). */
+export function McpConformanceDialog({ open, onOpenChange, url }: McpConformanceDialogProps) {
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-w-3xl">
+        <DialogHeader icon={FlaskConical}>
+          <DialogTitle>Conformance report</DialogTitle>
+          <DialogDescription className="font-mono">{url}</DialogDescription>
+        </DialogHeader>
+      </DialogContent>
+    </Dialog>
+  );
+}
