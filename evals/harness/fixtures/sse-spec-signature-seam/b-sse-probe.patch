+import { executeProxiedStreamingRequest } from '@/lib/shared/transport';
+import { buildSseStreamSpec } from './sseManager';
+
+export interface SseProbeResult {
+  ok: boolean;
+  status: number;
+  contentType: string;
+}
+
+/**
+ * Open the stream, read the response head, and close it again: used by the
+ * collection runner's "check endpoint" step to tell a misconfigured URL (HTML
+ * error page, 401) from a real `text/event-stream` before a long run starts.
+ */
+export async function probeSseEndpoint(
+  url: string,
+  headers: Record<string, string>,
+  signal?: AbortSignal
+): Promise<SseProbeResult> {
+  const controller = new AbortController();
+  const abort = () => controller.abort();
+  signal?.addEventListener('abort', abort, { once: true });
+  try {
+    const response = await executeProxiedStreamingRequest(
+      buildSseStreamSpec(url, { Accept: 'text/event-stream', ...headers }),
+      { signal: controller.signal }
+    );
+    const contentType = response.headers.get('content-type') ?? '';
+    return {
+      ok: response.ok && contentType.toLowerCase().startsWith('text/event-stream'),
+      status: response.status,
+      contentType,
+    };
+  } finally {
+    controller.abort();
+    signal?.removeEventListener('abort', abort);
+  }
+}
