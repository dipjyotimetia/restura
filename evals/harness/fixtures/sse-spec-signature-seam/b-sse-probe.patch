+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const executeProxiedStreamingRequest = vi.fn();
+vi.mock('@/lib/shared/transport', () => ({ executeProxiedStreamingRequest }));
+
+const { probeSseEndpoint } = await import('../sseProbe');
+
+describe('probeSseEndpoint', () => {
+  beforeEach(() => executeProxiedStreamingRequest.mockReset());
+
+  it('accepts a text/event-stream response', async () => {
+    executeProxiedStreamingRequest.mockResolvedValue(
+      new Response('', { status: 200, headers: { 'content-type': 'text/event-stream' } })
+    );
+    await expect(probeSseEndpoint('https://example.com/s', {})).resolves.toEqual({
+      ok: true,
+      status: 200,
+      contentType: 'text/event-stream',
+    });
+  });
+
+  it('rejects an HTML error page', async () => {
+    executeProxiedStreamingRequest.mockResolvedValue(
+      new Response('<html>', { status: 200, headers: { 'content-type': 'text/html' } })
+    );
+    const result = await probeSseEndpoint('https://example.com/s', {});
+    expect(result.ok).toBe(false);
+  });
+});
