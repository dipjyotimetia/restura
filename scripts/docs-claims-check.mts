// Docs claims check (#1015): the docs site names repo files and `npm run`
// scripts in backticks. Nothing else gates those, so a rename or deletion
// leaves the docs pointing at something that no longer exists.
//
// Checks every .mdx under docs-site/src/content/docs:
//   1. a backticked token that looks like a repo path (known top-level
//      directory, or a known root file) must exist;
//   2. every `npm run <script>` must be a script in the root package.json.
//
// It also checks that every port in echo-local/ports.ts appears in the
// testing/local-stack.mdx ports table (#1014), so a new service port can't be
// added without the docs noticing.
//
// ADR pages (architecture/adrs/) are point-in-time decision records: they name
// the files as they were when the decision was made, so they are not checked.
// Fenced code blocks are skipped: they show example output, not claims.
// Placeholders (<id>, *, {a,b}, …) are not checkable and are ignored. Paths
// that are deliberately not in this checkout go in `ALLOWED_MISSING` below,
// each with a reason.
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join, relative } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = fileURLToPath(new URL('..', import.meta.url));
const docsDir = join(root, 'docs-site', 'src', 'content', 'docs');

/** Top-level directories whose backticked paths are claims about this repo. */
const REPO_DIRS = [
  'cli',
  'docs',
  'docs-site',
  'e2e',
  'e2e-electron',
  'echo',
  'echo-local',
  'electron',
  'extensions',
  'scripts',
  'shared',
  'src',
  'tests',
  'worker',
];
const ROOT_FILES = [
  'CLAUDE.md',
  'CONTEXT.md',
  'REVIEW.md',
  'docker-compose.yml',
  'package.json',
  'wrangler.jsonc',
];

/** Documented paths that are intentionally absent from the checkout. */
const ALLOWED_MISSING = new Set<string>([
  // Generated by `npm run echo:local` and gitignored.
  'echo-local/manifest.json',
  'echo-local/restura-echo-local.collection.json',
  'echo-local/certs/',
]);

/** Point-in-time records, relative to the docs root. */
const SKIPPED_DIRS = ['architecture/adrs'];

function walk(dir: string): string[] {
  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
    const full = join(dir, entry.name);
    if (entry.isDirectory()) return walk(full);
    return entry.name.endsWith('.mdx') || entry.name.endsWith('.md') ? [full] : [];
  });
}

function stripFencedBlocks(source: string): string {
  return source.replace(/^(```|~~~)[^\n]*\n[\s\S]*?^\1[^\n]*$/gm, '');
}

function looksLikePath(token: string): boolean {
  if (/[\s<>*{}$|()[\]=:"']/.test(token)) return false;
  const first = token.split('/')[0] ?? '';
  if (token.includes('/')) return REPO_DIRS.includes(first);
  return ROOT_FILES.includes(token);
}

function pathExists(token: string): boolean {
  // `file.ts:12` / `file.ts#L12` style suffixes are not part of the path.
  const clean = token.replace(/[:#]L?\d+(-\d+)?$/, '').replace(/\/$/, '');
  const target = join(root, clean);
  if (existsSync(target)) return true;
  // Module specifiers are often written without an extension.
  return ['.ts', '.tsx', '.mts', '.mjs', '.js'].some((ext) => existsSync(`${target}${ext}`));
}

const pkg = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8')) as {
  scripts?: Record<string, string>;
};
const scripts = new Set(Object.keys(pkg.scripts ?? {}));

const problems: string[] = [];

for (const file of walk(docsDir)) {
  const rel = relative(root, file);
  if (SKIPPED_DIRS.some((dir) => relative(docsDir, file).startsWith(`${dir}/`))) continue;
  const text = stripFencedBlocks(readFileSync(file, 'utf8'));
  const lines = text.split('\n');
  lines.forEach((line, index) => {
    for (const match of line.matchAll(/`([^`\n]+)`/g)) {
      const token = (match[1] ?? '').trim();

      const run = /^npm run ([a-z0-9:_-]+)/i.exec(token);
      if (run) {
        const name = run[1] as string;
        if (!scripts.has(name)) {
          problems.push(`${rel}:${index + 1}  \`npm run ${name}\` is not a script in package.json`);
        }
        continue;
      }

      if (looksLikePath(token) && !ALLOWED_MISSING.has(token) && !pathExists(token)) {
        problems.push(`${rel}:${index + 1}  \`${token}\` does not exist in the repo`);
      }
    }
  });
}

// Read as text rather than imported: the file is a bare .ts module in a
// package without "type": "module", which makes Node warn on every load.
const portsSource = readFileSync(join(root, 'echo-local', 'ports.ts'), 'utf8');
const portsBlock = /export const PORTS = \{([\s\S]*?)\} as const;/.exec(portsSource)?.[1] ?? '';
const PORTS = Object.fromEntries(
  [...portsBlock.matchAll(/^\s*(\w+):\s*(\d+),/gm)].map((m) => [m[1], Number(m[2])])
);
if (Object.keys(PORTS).length === 0) {
  problems.push('echo-local/ports.ts: could not find the PORTS table');
}

const localStack = readFileSync(join(docsDir, 'testing', 'local-stack.mdx'), 'utf8');
for (const [name, port] of Object.entries(PORTS)) {
  if (!new RegExp(`(?<!\\d)${port}(?!\\d)`).test(localStack)) {
    problems.push(
      `docs-site/src/content/docs/testing/local-stack.mdx  port ${port} (PORTS.${name} in echo-local/ports.ts) is not documented`
    );
  }
}

if (problems.length > 0) {
  console.error(`docs-claims-check: ${problems.length} stale reference(s):\n`);
  for (const problem of problems) console.error(`  ${problem}`);
  console.error(
    '\nFix the docs, or add a deliberately-absent path to ALLOWED_MISSING in scripts/docs-claims-check.mts.'
  );
  process.exit(1);
}

console.log(
  'docs-claims-check: all backticked repo paths, npm scripts and echo-local ports are documented and exist.'
);
