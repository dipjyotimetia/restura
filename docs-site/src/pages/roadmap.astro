---
import '@fontsource-variable/geist/index.css';
import FeatureIcon from '../components/FeatureIcon.astro';
import '../styles/tree.css';
import {
  branches,
  features,
  statuses,
  reviewedOn,
  featurePosition,
  mapWidth,
  mapHeight,
  nodeWidth,
  nodeHeight,
  layout,
  featureGrid,
  columnX,
  rootX,
  rootLinkPath,
  branchLinePath,
  twigPath,
} from '../data/product-tree';
const reviewedDate = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(reviewedOn));
const totals = Object.keys(statuses).map((status) => ({
  status,
  label: statuses[status as keyof typeof statuses],
  count: features.filter((feature) => feature.status === status).length,
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restura Roadmap — Shipped, building, and next</title>
    <meta name="description" content="Explore Restura’s product roadmap: shipped features, work in progress, and ideas taking root. One client for every protocol." />
    <link rel="canonical" href="https://docs.restura.dev/roadmap/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Restura Roadmap — Shipped, building, and next" />
    <meta property="og:description" content="See what’s shipped, what’s growing, and where Restura goes next." />
    <meta property="og:image" content="https://docs.restura.dev/og-image.png" />
    <meta property="og:type" content="website" />
    <script is:inline>document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';</script>
  </head>
  <body>
    <a class="skip-link" href="#roadmap">Skip to roadmap</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Restura Docs home"><img src="/favicon.svg" alt="" width="28" height="28" /> Restura <span> / Roadmap</span></a>
      <nav aria-label="Page navigation"><a href="/overview/quick-start/">Documentation</a><a class="header-action" href="/overview/delivery-plan/">Delivery plan</a><a class="header-action" href="https://github.com/dipjyotimetia/restura/releases">Releases</a><button id="theme-toggle" class="icon-button enhanced" aria-label="Switch color theme" title="Switch color theme">◐</button></nav>
    </header>
    <main data-pagefind-body>
      <h1 class="sr-only">Restura roadmap</h1>
      <section id="roadmap" class="roadmap" aria-label="Product roadmap" tabindex="-1">
        <div class="toolbar">
          <div class="search-wrap enhanced"><label for="feature-search" class="sr-only">Search features</label><input id="feature-search" type="search" placeholder="Find a feature…" autocomplete="off" aria-controls="search-results" /><button id="clear-search" class="clear-search" aria-label="Clear search" hidden>×</button><ul id="search-results" aria-label="Search results" hidden></ul></div>
          <p id="result-count" role="status" aria-live="polite">{features.length} features across {branches.length} branches</p>
          <div class="status-filters" role="group" aria-label="Filter features by status">
            <button class="filter enhanced" data-filter="all" disabled aria-pressed="true">All <span>{features.length}</span></button>
            {totals.map(({ status, label, count }) => <button class="filter" data-filter={status} disabled aria-pressed="false"><i class={`status-dot ${status}`} aria-hidden="true"></i>{label}<span>{count}</span></button>)}
          </div>
          <div class="branch-navigation enhanced" role="group" aria-label="Explore a roadmap branch">
            <button data-branch-filter="all" aria-pressed="true">All branches</button>
            {branches.map((branch) => <button data-branch-filter={branch.id} aria-pressed="false"><span class="nav-symbol" aria-hidden="true">{branch.symbol}</span>{branch.label}</button>)}
          </div>
          <div class="view-switch enhanced" role="group" aria-label="Roadmap view"><button id="tree-view" aria-pressed="true">Tree</button><button id="list-view" aria-pressed="false">List</button></div>
        </div>
        <div id="empty-state" hidden><p>No matching features in this view.</p><button id="clear-filters">Clear filters and search</button></div>
        <div class="map-stage enhanced">
        <div id="tree-controls" class="tree-controls enhanced">
          <div class="map-caption"><span>Scroll to pan · <kbd>Ctrl</kbd>/<kbd>⌘</kbd> + scroll to zoom · Click a box to expand</span></div>
          <div class="zoom-controls" role="group" aria-label="Map controls"><button id="zoom-out" aria-label="Zoom out">−</button><output id="zoom-level" aria-label="Zoom level">100%</output><button id="zoom-in" aria-label="Zoom in">+</button><button id="reset-map">Fit tree</button></div>
        </div>
        <div id="tree-viewport" class="tree-viewport enhanced" role="region" aria-label="Interactive feature tree. Drag the background to pan. Use the zoom controls or switch to List for keyboard browsing." tabindex="0">
          <div id="tree-canvas" class="tree-canvas" style={`width:${mapWidth}px;height:${mapHeight}px`}>
            <svg class="connections" width={mapWidth} height={mapHeight} viewBox={`0 0 ${mapWidth} ${mapHeight}`} aria-hidden="true">
              {branches.map((branch, index) => {
                const items = features.filter((feature) => feature.branch === branch.id);
                const last = items.at(-1);
                const bottom = last ? featurePosition(last).y + nodeHeight / 2 : layout.headingY + 97;
                return <g data-branch-edge={branch.id}><path class="root-link" pathLength="1" d={rootLinkPath(index)} /><path class="branch-line" pathLength="1" style={`--enter:${320 + index * 50}ms`} d={branchLinePath(index, bottom)} />{items.map((feature) => { const { x, y } = featurePosition(feature); return <path class="twig" data-edge={feature.id} d={twigPath(x, y)} />; })}</g>;
              })}
              <g id="dependency-lines"></g>
            </svg>
            <div class="root-node" style={`left:${rootX}px;top:${layout.rootTop}px`}><span><img src="/favicon.svg" alt="" width="28" height="28" />Restura</span><small>Local first. Open source.</small></div>
            {branches.map((branch, index) => <div class="branch-heading" data-map-branch={branch.id} style={`left:${columnX(index)}px;top:${layout.headingY}px;width:${nodeWidth}px;--enter:${180 + index * 50}ms`}><span class="branch-symbol" aria-hidden="true">{branch.symbol}</span><div><h2>{branch.label}</h2><p>{branch.description}</p></div></div>)}
            {features.map((feature) => {
              const { x, y } = featurePosition(feature);
              const { column, row } = featureGrid(feature);
              return <article class="feature-card" data-card={feature.id} style={`left:${x}px;top:${y}px;width:${nodeWidth}px;--enter:${380 + column * 50 + row * 30}ms`}><button class="feature-node" data-feature={feature.id} data-status={feature.status} style={`height:${nodeHeight}px`} title={`${feature.title} — ${statuses[feature.status]}`} aria-label={`${feature.title}, ${statuses[feature.status]}`} aria-expanded="false" aria-controls="feature-detail"><FeatureIcon id={feature.id} branch={feature.branch} /><span>{feature.title}</span><i class={`status-dot ${feature.status}`} aria-hidden="true"></i><span class="node-open" aria-hidden="true">+</span></button></article>;
            })}
          </div>
        </div>
        </div>
        <div id="feature-list" class="feature-list">
          {branches.map((branch, index) => <section data-list-branch={branch.id} style={`--enter:${index * 50}ms`}><h2><span aria-hidden="true">{branch.symbol}</span> {branch.label}</h2><p>{branch.description}</p>{features.filter((feature) => feature.branch === branch.id).map((feature) => <details data-list-feature={feature.id} data-status={feature.status}><summary><span class="feature-label"><FeatureIcon id={feature.id} branch={feature.branch} />{feature.title}</span><span class="list-status"><i class={`status-dot ${feature.status}`} aria-hidden="true"></i>{statuses[feature.status]}</span></summary><div class="list-detail" id={feature.id}><p>{feature.description}</p><p><strong>{feature.status === 'shipped' ? 'Platforms:' : 'Intended platforms:'}</strong> {feature.platforms.join(', ')}</p>{feature.prerequisites.length > 0 && <p><strong>Prerequisites:</strong> {feature.prerequisites.map((id, index) => <><a href={`#${id}`}>{features.find((item) => item.id === id)?.title}</a>{index < feature.prerequisites.length - 1 ? ', ' : ''}</>)}</p>}{feature.href && <a href={feature.href}>Read documentation</a>}</div></details>)}</section>)}
        </div>
      </section>
    </main>
    <footer><p>Built in the open. Shaped by the people who use it.</p><p>Reviewed <time datetime={reviewedOn}>{reviewedDate}</time> <span aria-hidden="true">/</span> <a href="https://github.com/dipjyotimetia/restura">View on GitHub</a></p></footer>
    <section id="feature-detail" class="inline-feature-detail" aria-label="Feature details" hidden>
      <button id="close-detail" class="icon-button" aria-label="Close feature details">×</button>
      <p id="detail-status"></p><h3 id="detail-title" class="sr-only" tabindex="-1"></h3><p id="detail-description"></p>
      <h3 id="detail-platform-heading">Platforms</h3><p id="detail-platforms"></p><div id="detail-prerequisites"><h3>Built on</h3><ul></ul></div>
      <div id="detail-unlocks"><h3>Builds toward</h3><ul></ul></div>
      <p id="detail-planned-note" hidden>Planned availability is a direction, not a delivery commitment.</p>
      <div class="detail-actions"><a id="detail-plan" hidden>See milestones in the delivery plan</a><a id="detail-docs">Read documentation</a><a href="https://github.com/dipjyotimetia/restura/issues/new?template=feature_request.yml">Share feedback</a><button id="copy-link">Copy feature link</button><span id="copy-status" role="status"></span></div>
    </section>
    <script>import '../scripts/product-tree';</script>
  </body>
</html>
