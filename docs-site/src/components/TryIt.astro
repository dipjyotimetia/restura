---
/**
 * "Try it" panel for protocol pages (#1013).
 *
 * Protocols the public echo server serves get a ready-made OpenCollection
 * (docs-site/public/samples/<protocol>.opencollection.json, generated by
 * `npm run docs:samples` and import-tested in tests/docs/docs-samples.test.ts):
 *   - "Open in Restura desktop" uses the existing `restura://import` deep link
 *     (docs/DEEP_LINKS.md). The app shows the source URL and only downloads it
 *     after the user chooses Download and import; nothing is sent automatically.
 *   - "Download sample" works everywhere: import the file via Import → OpenCollection.
 * Protocols with no public echo (Socket.IO, Kafka, MQTT, MCP) point at the
 * local echo stack instead.
 */
interface Props {
  protocol:
    | 'http'
    | 'graphql'
    | 'grpc'
    | 'websocket'
    | 'sse'
    | 'socketio'
    | 'kafka'
    | 'mqtt'
    | 'mcp';
}

const { protocol } = Astro.props;

const SAMPLES: Record<string, { label: string; endpoint: string }> = {
  http: { label: 'HTTP', endpoint: 'https://echo.restura.dev/get?hello=world' },
  graphql: { label: 'GraphQL', endpoint: 'https://echo.restura.dev/graphql' },
  grpc: {
    label: 'gRPC',
    endpoint: 'https://echo.restura.dev (echo.v1.EchoService, reflection on)',
  },
  websocket: { label: 'WebSocket', endpoint: 'wss://echo.restura.dev/ws' },
  sse: { label: 'SSE', endpoint: 'https://echo.restura.dev/sse' },
};

const LOCAL_ONLY: Record<string, string> = {
  socketio: 'Socket.IO',
  kafka: 'Kafka',
  mqtt: 'MQTT',
  mcp: 'MCP',
};

const sample = SAMPLES[protocol];
const site = (Astro.site ?? new URL('https://docs.restura.dev')).toString().replace(/\/$/, '');
const samplePath = `/samples/${protocol}.opencollection.json`;
const deepLink = sample
  ? `restura://import?url=${encodeURIComponent(`${site}${samplePath}`)}&format=opencollection`
  : undefined;
---

<aside class="try-it" aria-label="Try it">
  {
    sample ? (
      <>
        <p class="try-it-title">Try it against the public echo server</p>
        <p class="try-it-sub">
          A ready-made {sample.label} request for <code>{sample.endpoint}</code>.
        </p>
        <div class="try-it-actions">
          <a class="try-it-btn try-it-primary" href={deepLink}>
            Open in Restura desktop
          </a>
          <a class="try-it-btn" href={samplePath} download>
            Download sample collection
          </a>
        </div>
        <p class="try-it-note">
          The desktop app asks before it downloads anything. In the web app, import the downloaded
          file with <strong>Import → OpenCollection</strong>.
        </p>
      </>
    ) : (
      <>
        <p class="try-it-title">Try it locally</p>
        <p class="try-it-sub">
          There is no public {LOCAL_ONLY[protocol]} echo. Run <code>npm run echo:local</code> and
          import the generated collection; see <a href="/testing/local-stack/">Local echo stack</a>.
        </p>
      </>
    )
  }
</aside>

<style>
  .try-it {
    margin-block: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }
  .try-it-title {
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .try-it-sub,
  .try-it-note {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .try-it-note {
    color: var(--sl-color-gray-3);
  }
  .try-it-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .try-it-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .try-it-btn:hover {
    border-color: var(--sl-color-accent);
  }
  .try-it-primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
</style>
