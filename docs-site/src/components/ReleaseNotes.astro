<section id="release-feed" aria-label="Published releases">
  <p id="release-status" role="status">Loading release notes…</p>
  <div id="release-items" aria-busy="true"></div>
  <button id="release-more" type="button" hidden>Load older releases</button>
  <p><a href="https://github.com/dipjyotimetia/restura/releases">View releases on GitHub ↗</a></p>
  <noscript><p>Enable JavaScript to read release notes here, or follow the GitHub link above.</p></noscript>
</section>

<script>
  import { initReleaseNotes } from '../scripts/release-notes';
  initReleaseNotes();
</script>

<style>
  #release-items :global(article) { border-block-start: 1px solid var(--sl-color-gray-5); padding-block: 1.5rem; }
  #release-items :global(h2) { margin-top: 0; }
  #release-items :global(.release-meta) { color: var(--sl-color-gray-2); font-size: 0.875rem; }
  #release-items :global(pre) { overflow-x: auto; }
  #release-items :global(.release-plain) { white-space: pre-wrap; overflow-wrap: anywhere; }
  #release-more { padding: 0.65rem 1rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.5rem; background: var(--sl-color-gray-6); color: var(--sl-color-text); cursor: pointer; font: inherit; }
  #release-more:disabled { opacity: 0.6; cursor: wait; }
</style>
